@page "/medicinedetails"
@using Microsoft.AspNetCore.Authorization
@using OnlineMedicalStore.Models
@using OnlineMedicalStore.Service
@rendermode InteractiveServer
@inject AuthenticationStateProvider AuthenticationStateProvider
@attribute [Authorize(Roles = "Admin")]
@inject MedicineService Medicineservice
@{
    var id = 1;
}

<table class="medicine-table">
    <thead>
        <tr>
            <th>Serial Number</th>
            <th>Medicine Name</th>
            <th>Medicine Count</th>
            <th>Medicine Price</th>
            <th>Expiry Date</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>

        @foreach (var medicine in medicineDetails1)
        {
            <tr>
                <td>@(id++)</td>
                <td>@medicine.MedicineName</td>
                <td>@medicine.MedicineCount</td>
                <td>@medicine.MedicinePrice</td>
                <td>@medicine.ExpiryDate.ToShortDateString()</td>
                <td>
                    <button @onclick="() => Edit(medicine)">Edit</button>
                    <button @onclick="() => DeleteMedicine(medicine)">Delete</button>
                </td>

            </tr>

        }

    </tbody>
</table>
<button class="addbutton" @onclick="Add">Add</button>
@if (form)
{


    <EditForm Model="@medi" OnValidSubmit="EditMedicine" FormName="FormInfo">
        <div class="form">
            <label for="">MedicineName</label>
            <InputText @bind-Value="medi.MedicineName"></InputText>
            <label for="">MedicineCount</label>
            <InputNumber @bind-Value="medi.MedicineCount"></InputNumber>
            <label for="">Medicineprice</label>
            <InputNumber @bind-Value="medi.MedicinePrice"></InputNumber>
            <label for="">ExpiryDate</label>
            <InputDate @bind-Value="medi.ExpiryDate"></InputDate>
            <button class="addbutton1" type="submit">@((formEdit) ? "Update" : "Add")</button>
        </div>
    </EditForm>
}
@if (ShowMessage)
{
    <div class="popup">
        <h1>@Message</h1>
        <button @onclick="DisableMessage">Ok</button>
    </div>
}

@code
{
    string Message = "";
    public List<MedicineInfo> medicineDetails1 = new List<MedicineInfo>();
    MedicineInfo medi = new MedicineInfo();
    bool form = false;
    bool formEdit = false;
    bool ShowMessage = false;
    private void DisableMessage()
    {
        ShowMessage = false;
        Message = "";
        StateHasChanged();
    }
    protected override void OnInitialized()
    {
        medicineDetails1 = Medicineservice.GetMedicine();
    }
    @* DeleteMedicine *@
    public void DeleteMedicine(MedicineInfo medicine)
    {
        if (Medicineservice.Delete(medicine))
        {
            ShowMessage = true;
            Message = "DSCM";
        }
        StateHasChanged();
    }
    @* Add medicine *@
    public void Add()
    {
        form = true;
        formEdit = false;
    }
    public void Edit(MedicineInfo medicine)
    {
        medi = new MedicineInfo
        {
            MedicineId = medicine.MedicineId,
            MedicineName = medicine.MedicineName,
            MedicineCount = medicine.MedicineCount,
            MedicinePrice = medicine.MedicinePrice,
            ExpiryDate = medicine.ExpiryDate
        };
        form = true;
        formEdit = true;
    }
    public void EditMedicine()
    {
        if (formEdit)
        {

            if (Medicineservice.Edit(medi))
            {
                ShowMessage = true;
                Message = "SCEM";
            }
        }
        else
        {
            if (Medicineservice.Add(medi))
            {
                ShowMessage = true;
                Message = "SCAM";
            }
        }
        form = false;
        StateHasChanged();
    }
}