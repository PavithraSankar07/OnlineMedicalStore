@page "/orderdetails"
@using Microsoft.AspNetCore.Authorization
@using OnlineMedicalStore.Models
@using OnlineMedicalStore.Service
@rendermode InteractiveServer
@inject OrderService OrderService
@inject UserService UserService
@inject MedicineService MedicineService
@attribute [Authorize(Roles = "Admin")]



@if (!string.IsNullOrEmpty(Message))
{
    
        @Message
    
}
@{
    var id=1;
}
<table class="medicine-table">
    <thead>
        <tr>
            
            <th>Serial Number</th>
            <th>Medicine Name</th>
            <th>User ID</th>
            <th>Quantity</th>
            <th>Total Price</th>
            <th>Status</th>
            <th>Order Date</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Orders)
        {
            var user=UserService.users.Find(u=>u.UserID==order.UserID);
            
            <tr>
              
                <td>@(id++)</td>
                <td>@order.MedicineName</td>
                <td>@(user.Name)</td>
                <td>@order.MedicineCount</td>
                <td>@order.TotalPrice</td>
                <td>@order.PurchaseStatus</td>
                <td>@order.OrderDate.ToShortDateString()</td>
                <td>
                    @if (order.PurchaseStatus != "Cancelled")
                    {
                        <button  @onclick="() => CancelOrder(order)">Cancel</button>
                    
                    }
                    else
                    {
                        <span >Cancelled</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
 @if (ShowMessage)
        {
            <div class="popup">
                <h1>@Message</h1>
                <button @onclick="DisableMessage">Ok</button>
            </div>
        }
         

@code {
    bool ShowMessage=false;
    private void DisableMessage()
    {
        ShowMessage = false;
        Message = "";
        
        StateHasChanged();
    }
    public static List<OrderInfo> Orders = new();
    public string Message = string.Empty;

    protected override void OnInitialized()
    {
        
    }
protected override async Task OnAfterRenderAsync(bool firstrender)
{
    if(firstrender)
    {
      Orders = OrderService.GetOrders();
        StateHasChanged();
    }
}
 
    public void CancelOrder(OrderInfo order)
    {
        Message="hii";
        if (order.PurchaseStatus == "Cancelled")
        {
            Message = "Order is already cancelled.";
          
            return;
        }
        var user = UserService.users.Find(u =>
            u.UserID == order.UserID  );

        if (user == null)
        {
            Message = $"User '{order.UserID}' not found.";
            return;
        }
        var medicine = MedicineService.Medicines.Find(m => m.MedicineId == order.MedicineID);
        if (medicine == null)
        {
            Message = "Medicine not found";
           
            return;
        }


        user.WalletBalance += order.TotalPrice;

     
        medicine.MedicineCount += order.MedicineCount;

        
        order.PurchaseStatus = "Cancelled";

        Message = $"Order {order.OrderID}  cancelled";
    

       
        StateHasChanged();
        
    }
}
