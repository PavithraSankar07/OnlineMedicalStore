@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin,user")]
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<AuthorizeView Roles="Admin,User">
    <Authorized>
        <div class="top-row ps-3 navbar navbar-dark">
            <div class="container-fluid">
                <a class="navbar-brand" href="">OnlineMedicalStore</a>
            </div>
            <button @onclick="Logout">LogOut</button>
        </div>
    </Authorized>
</AuthorizeView>
<AuthorizeView Roles="Admin,User">
    <Authorized Context="Outer">
        <input type="checkbox" title="Navigation menu" class="navbar-toggler" />

        <div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
            <nav class="flex-column">
                <AuthorizeView Roles="Admin,User">
                    <Authorized Context="Inner">
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="home">
                                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Home
                            </NavLink>
                        </div>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView Roles="Admin">
                    <Authorized Context="Inner">
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="medicinedetails">
                                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> MedicineDetails
                            </NavLink>
                        </div>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView Roles="Admin,User">
                    <Authorized Context="Inner">
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="purchase">
                                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Purchase
                            </NavLink>
                        </div>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView Roles="Admin">
                    <Authorized Context="Inner">
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="orderdetails">
                                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> OrderDetails
                            </NavLink>
                        </div>
                    </Authorized>
                </AuthorizeView>
                <AuthorizeView Roles="Admin,User">
                    <Authorized Context="Inner">
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="walletrecharge">
                                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> WalletRecharge
                            </NavLink>
                        </div>
                    </Authorized>
                </AuthorizeView>
            </nav>
        </div>
    </Authorized>
</AuthorizeView>
@code
{
    public string name;
    protected override async Task OnAfterRenderAsync(bool render)
    {
        if (render)
        {
            var authstate = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            if (authstate.User.Identity.Name != null)
            {
                var user = authstate.User;
               
                name = user.Identity.Name;
                StateHasChanged();
            }

        }
    }
     private void Logout()
    {
        Navigation.NavigateTo("/api/login/logout",forceLoad: true);
    }
}