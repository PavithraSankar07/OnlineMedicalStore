@inject NavigationManager Navigation
@inject UserStateService UserState
@inherits LayoutComponentBase

<PageTitle>Online Medical Store</PageTitle>

<div class="main-layout">
    @if (UserState.CurrentUser is not null)
    {
      <nav class="nav-menu">
    <ul>
        <li><NavLink href="/home">Home</NavLink></li>
        <li><NavLink href="/medicinedetails">Medicine Details</NavLink></li>
        <li><NavLink href="/purchase">Purchase</NavLink></li>
        <li><NavLink href="/orderhistory">History</NavLink></li>
        <li><NavLink href="/walletrecharge">WalletRecharge</NavLink></li>
        <li><a @onclick="Logout">Logout</a></li>
    </ul>
</nav>

    }

    <div class="body">
        @Body
    </div>
</div>

@code {
    private void Logout()
    {
        UserState.CurrentUser = null;
        Navigation.NavigateTo("/");
    }
}
