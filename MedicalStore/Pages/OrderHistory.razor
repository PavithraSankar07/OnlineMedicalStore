@page "/orderhistory"
@using MedicalStore.Models
@inject UserStateService UserState

<h3>Order History</h3>

@if (UserState.CurrentUser == null)
{
    <p>Please login to view your order history.</p>
}
else if (userOrders.Count == 0)
{
    <p>No orders found.</p>
}
else
{
    <table class="medicine-table">
        <thead>
            <tr>
                <th>S.NO</th>
                <th>Medicine Name</th>
                <th>Quantity</th>
                <th>Total Price</th>
                <th>Order Date</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in userOrders)
            {
                <tr>
                    <td>@order.SerialNumber</td>
                    <td>@order.MedicineName</td>
                    <td>@order.MedicineCount</td>
                    <td>@order.TotalPrice</td>
                    <td>@order.OrderDate.ToString("yyyy-MM-dd")</td>
                    <td>@order.PurchaseStatus</td>
                    <td>
                        <button @onclick="() => ConfirmCancel(order)" disabled="@IsCancelled(order)">Cancel</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@* @if (!string.IsNullOrEmpty(message))
{
    <p>@message</p>
} *@

<CustomDialog 
    IsVisible="@showDialog" 
    Message="@dialogMessage" 
    OnClose="CloseDialog" 
    OnCancel="CloseDialog" 
    OnConfirm="Cancel" />

<DialogBox Message="@canceMessage" IsVisible="@showCancelBox" OnClose="@Close"></DialogBox>
@code {
    private static string canceMessage;
    private bool showCancelBox = false;
    private void Close()
    {
        showCancelBox = false;
    }
    private void ShowDialogMessage(string message)
    {
        canceMessage=message;
        showCancelBox=true;
        StateHasChanged();
    }

    @* ------------------------------------- *@
    private List<OrderInfo> userOrders = new();
    private string message;

    private bool showDialog = false;
    private string dialogMessage = string.Empty;
    private OrderInfo? orderToCancel;

    protected override void OnInitialized()
    {
        LoadUserOrders();
    }

    private void LoadUserOrders()
    {
        if (UserState.CurrentUser != null)
        {
            userOrders = UserState.Orders
                .Where(o => o.UserID == UserState.CurrentUser.UserID)
                .ToList();
        }
    }

    private bool IsCancelled(OrderInfo order) =>
        order.PurchaseStatus.ToLower() == "cancelled";

    private void ConfirmCancel(OrderInfo order)
    {
        orderToCancel = order;
        dialogMessage = $"Are you sure you want to cancel Order ID {order.OrderID} for {order.MedicineName}?";
        showDialog = true;
    }

    private Task CloseDialog()
    {
        showDialog = false;
        orderToCancel = null;
        return Task.CompletedTask;
    }

    private Task Cancel()
    {
        if (orderToCancel == null)
            return Task.CompletedTask;

        var order = orderToCancel;

        if (IsCancelled(order))
        {
            ShowDialogMessage("Order already cancelled");
            @* message = "Order already cancelled."; *@
            showDialog = true;
            orderToCancel = null;
            return Task.CompletedTask;
        }
        order.PurchaseStatus = "Cancelled";

       
        if (UserState.CurrentUser != null)
        {
            UserState.CurrentUser.WalletBalance += order.TotalPrice;
        }

    
        var medicine = UserState.Medicines.Find(m => m.MedicineId == order.MedicineID);
        if (medicine != null)
        {
            medicine.MedicineCount += order.MedicineCount;
        }

        @* message = $"Order ID {order.OrderID} has been cancelled and ₹{order.TotalPrice} has been refunded."; *@
        ShowDialogMessage($"{order.OrderID} has been cancelled");

       
        showDialog = false;
        orderToCancel = null;
        return Task.CompletedTask;
    }
}
