@page "/"
@using MedicalStore.Models
@inject UserStateService UserState
@inject NavigationManager Navigation

<div class="whole-div">
    <button @onclick="ShowLogin" >Login</button>
    <button @onclick="ShowSignup" >Sign Up</button>
</div>

@if (showLogin)
{
    <EditForm Model="@userInfo" OnValidSubmit="Login">
        <div class="login" id="full-form">
            <h2>Login</h2>
            <InputText @bind-Value="userInfo.Email" placeholder="Email" />
            <InputText @bind-Value="userInfo.Password" type="password" placeholder="Password" />
            <button type="submit">Login</button>
        </div>
    </EditForm>
}
else
{
    <EditForm Model="@userInfo" OnValidSubmit="Signup">
        <div class="signup" id="full-form">
            <h2>Sign Up</h2>
            <InputText @bind-Value="userInfo.Name" placeholder="Name" />
            <InputText @bind-Value="userInfo.Email" placeholder="Email" />
            <InputText @bind-Value="userInfo.MobileNumber" placeholder="Mobile Number" />
            <InputText @bind-Value="userInfo.Password" type="password" placeholder="Password" />
            <button type="submit">Sign Up</button>
        </div>
    </EditForm>
}
@* @if(!string.IsNullOrEmpty(message))
{
    <p>@message</p>
} *@

<DialogBox Message="@dialogBoxMessage" IsVisible="@showBox" OnClose="@Close"/>
@code {
    private UserInfo userInfo = new();
    private bool showLogin = true;
    private bool isLoggedIn = false;
    private static string message;
private static string dialogBoxMessage;
private bool showBox=false;
private void ShowDialog(string message)
    {
        dialogBoxMessage = message;
        showBox = true;
        StateHasChanged();
    }
private void Close()
{
  showBox=false;
  
}
 
    private void ShowLogin()
    {
        showLogin=true;
    userInfo.Email = string.Empty;
    userInfo.Password = string.Empty;
   }
    private void ShowSignup()
    {
        showLogin = false;
        userInfo = new();
    }

    private void Login()
    {
        var existingUser = UserState.Users.Find(u =>
            u.Email == userInfo.Email && u.Password == userInfo.Password);

        if (existingUser != null)
        {
            UserState.CurrentUser = existingUser;
            isLoggedIn = true;
            Navigation.NavigateTo("/home");
        }
        else
        {
            isLoggedIn = false;
            @* message="Invalid credentials"; *@
            ShowDialog("Invalid credentials");
         
        }
    }

    private void Signup()
    {
        var existingUser = UserState.Users.Find(u => u.Email == userInfo.Email);
        if (existingUser != null)
        {
            @* message="Email already exists"; *@
            ShowDialog("Email already exist");
       
        }
        else
        {
            var newUser = new UserInfo
            {
               
                Name = userInfo.Name,
                Email = userInfo.Email,
                Password = userInfo.Password,
                MobileNumber = userInfo.MobileNumber,
                WalletBalance = 0
            };

            UserState.Users.Add(newUser);
            @* message="SignUp Successful"; *@
            ShowDialog("Signup Successful");
        
              userInfo = new();
            
        }
    }
}
