@page "/purchase"
@using MedicalStore.Models
@inject UserStateService UserState


<h3>Purchase Medicines</h3>

<table class="medicine-table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Price</th>
            <th>Available</th>
            <th>Expiry</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var medicine in UserState.Medicines)
        {
            <tr>
                <td>@medicine.MedicineName</td>
                <td>@medicine.MedicinePrice</td>
                <td>@medicine.MedicineCount</td>
                <td>@medicine.ExpiryDate.ToShortDateString()</td>
                <td>
                    <button @onclick="() => StartPurchase(medicine)">Buy</button>
                </td>
            </tr>
        }
    </tbody>
</table>
